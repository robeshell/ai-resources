    {
      "id": "platform",
      "label": {
        "zh": "平台",
        "en": "Platform"
      },
      "note": "有几个填几个。"
    }
  ],
  "tags": [
    {
      "id": "coding",
      "group": "category",
      "label": {
        "zh": "编程",
        "en": "Coding"
