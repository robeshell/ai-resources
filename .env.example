# Curator only binds to your computer. Change these only when the default ports conflict.
CURATOR_PORT=4317
CURATOR_SITE_PORT=3000
CURATOR_ALLOWED_ORIGIN=http://localhost:3000
NEXT_PUBLIC_CURATOR_API_URL=http://127.0.0.1:4317

# Set to 1 to use metadata and rules without invoking Codex.
CURATOR_DISABLE_AI=0
