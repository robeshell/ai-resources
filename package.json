{
  "name": "ai-resources",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "curator": "node --env-file-if-exists=.env.local scripts/curator-dev.mjs",
    "curator:server": "node --env-file-if-exists=.env.local scripts/curator-server.mjs",
    "curator:migrate:check": "node scripts/curator-migrate.mjs",
    "curator:migrate": "node scripts/curator-migrate.mjs --write",
    "curator:db:check": "node scripts/curator-db.mjs",
    "curator:db:import": "node scripts/curator-db.mjs --write",
    "curator:export:check": "node scripts/curator-export.mjs",
    "curator:export": "node scripts/curator-export.mjs --write",
    "build": "next build",
    "start": "next start",
    "lint": "eslint"
  },
  "dependencies": {
    "@mantine/core": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "typescript": "^5"
  }
}
