{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "kind",
    "category",
    "pricing",
    "platforms",
    "verdict",
    "summary",
    "relatedSlugs",
    "confidence",
    "rationale"
  ],
  "properties": {
    "name": { "type": "string" },
    "slug": { "type": "string" },
    "kind": { "enum": ["tool", "skill", "open-source", "model"] },
    "category": { "enum": ["code", "chat", "image", "video", "research", "agents"] },
    "pricing": { "enum": ["free", "freemium", "paid", "api"] },
    "platforms": {
      "type": "array",
      "items": { "enum": ["web", "app", "api", "cli"] }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 4, "maxLength": 72 },
        "zh": { "type": "string", "minLength": 4, "maxLength": 36 }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["en", "zh"],
      "properties": {
        "en": { "type": "string", "minLength": 8, "maxLength": 140 },
        "zh": { "type": "string", "minLength": 8, "maxLength": 72 }
      }
    },
    "relatedSlugs": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "rationale": { "type": "string" }
  }
}
