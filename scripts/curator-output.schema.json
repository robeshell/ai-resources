{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "slug",
    "kind",
    "blockType",
    "tags",
    "verdict",
    "summary",
    "description",
    "confidence",
    "rationale",
    "body",
    "links",
    "prompt",
    "variables",
    "examples",
    "logoUrl"
  ],
  "properties": {
    "name": {
      "type": "string"
    },
    "slug": {
      "type": "string"
    },
    "kind": {
      "enum": [
        "tool",
        "skill",
        "open-source",
        "prompt"
      ]
    },
    "blockType": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "tool",
        "skill",
        "project",
        "prompt",
        null
      ]
    },
    "tags": {
      "description": "标签 id，从提示词给出的词表里选。用途至少 1 个，定价最多 1 个，平台有几个填几个。词表里实在没有合适的才自造，用英文小写连字符。",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "verdict": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 4,
          "maxLength": 72
        },
        "zh": {
          "type": "string",
          "minLength": 4,
          "maxLength": 36
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "minLength": 8,
          "maxLength": 140
        },
        "zh": {
          "type": "string",
          "minLength": 8,
          "maxLength": 72
        }
      }
    },
    "description": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 900
        },
        "zh": {
          "type": "string",
          "maxLength": 480
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rationale": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 24000
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "url",
          "kind"
        ],
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "url": {
            "type": "string",
            "minLength": 8,
            "maxLength": 2000
          },
          "kind": {
            "enum": [
              "official",
              "docs",
              "repository",
              "reference",
              "other"
            ]
          }
        }
      }
    },
    "prompt": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 16000
    },
    "variables": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "description",
          "example"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "example": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 1000
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input",
          "output"
        ],
        "properties": {
          "input": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "output": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000
          }
        }
      }
    },
    "logoUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "页面图标（favicon 或 og:image）的完整 URL；找不到用 null"
    }
  }
}
